\set ON_ERROR_STOP on
\prompt 'Project database name (default railway_sign): ' database_name
\prompt 'Project runtime role (default railway_sign_app): ' app_role
SELECT COALESCE(NULLIF(:'database_name', ''), 'railway_sign') AS database_name \gset
SELECT COALESCE(NULLIF(:'app_role', ''), 'railway_sign_app') AS app_role \gset

SELECT CASE WHEN :'database_name' ~ '^[a-z][a-z0-9_]{0,62}$' THEN 1 ELSE 1 / 0 END;
SELECT CASE WHEN :'app_role' ~ '^[a-z][a-z0-9_]{0,62}$' THEN 1 ELSE 1 / 0 END;

SELECT format($sql$DO $body$ BEGIN
  IF EXISTS (SELECT 1 FROM pg_database WHERE datname = %L
    AND pg_get_userbyid(datdba) IS DISTINCT FROM %L) THEN
    RAISE EXCEPTION 'Database exists with a different owner; inspect and migrate it explicitly';
  END IF;
END $body$;$sql$, :'database_name', :'app_role')\gexec

SELECT format('CREATE ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT', :'app_role')
WHERE NOT EXISTS (SELECT 1 FROM pg_roles WHERE rolname = :'app_role')\gexec

\password :app_role

SELECT format('CREATE DATABASE %I OWNER %I', :'database_name', :'app_role')
WHERE NOT EXISTS (SELECT 1 FROM pg_database WHERE datname = :'database_name')\gexec

SELECT format('REVOKE ALL ON DATABASE %I FROM PUBLIC', :'database_name')\gexec
SELECT format('GRANT CONNECT, TEMPORARY ON DATABASE %I TO %I', :'database_name', :'app_role')\gexec
SELECT format('ALTER ROLE %I LOGIN NOSUPERUSER NOCREATEDB NOCREATEROLE NOREPLICATION NOBYPASSRLS NOINHERIT', :'app_role')\gexec

\connect :database_name
SELECT format('GRANT USAGE, CREATE ON SCHEMA public TO %I', :'app_role')\gexec
SELECT format('GRANT SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER ON ALL TABLES IN SCHEMA public TO %I', :'app_role')\gexec
SELECT format('GRANT USAGE, SELECT, UPDATE ON ALL SEQUENCES IN SCHEMA public TO %I', :'app_role')\gexec
SELECT format('ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT SELECT, INSERT, UPDATE, DELETE, TRUNCATE, REFERENCES, TRIGGER ON TABLES TO %I', :'app_role')\gexec
SELECT format('ALTER DEFAULT PRIVILEGES IN SCHEMA public GRANT USAGE, SELECT, UPDATE ON SEQUENCES TO %I', :'app_role')\gexec

\echo 'Created/reused a project-scoped PostgreSQL role and database. Runtime role has no cluster administration privileges.'
