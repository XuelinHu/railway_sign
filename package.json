{
  "name": "railway_sign",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "telemetry": "node server/telemetry-bridge.js",
    "api": "node --env-file-if-exists=server/.env scripts/start-api.mjs",
    "db:migrate": "node --env-file-if-exists=server/.env scripts/migrate-postgres.mjs",
    "db:migrate:oidc": "node --env-file-if-exists=server/.env scripts/migrate-oidc-postgres.mjs",
    "db:import:sqlite": "node --env-file-if-exists=server/.env scripts/migrate-sqlite-to-postgres.mjs",
    "db:seed:test": "node --env-file-if-exists=server/.env scripts/seed-test-data.mjs",
    "test:api": "node scripts/test-api.mjs",
    "test:ingest-auth": "node scripts/test-ingest-auth.mjs",
    "admin:bootstrap": "node --env-file-if-exists=server/.env scripts/bootstrap-admin.mjs",
    "test:production-bootstrap": "node --env-file-if-exists=server/.env scripts/test-production-bootstrap.mjs",
    "db:backup": "node --env-file-if-exists=server/.env scripts/db-maintenance.mjs backup",
    "db:restore": "node --env-file-if-exists=server/.env scripts/db-maintenance.mjs restore",
    "test:db-maintenance": "node --test test/postgres-backup.test.mjs",
    "test:postgres-integration": "node --env-file-if-exists=server/.env --test test/postgres.integration.test.mjs",
    "voice": "node scripts/start-voice.mjs",
    "dev": "vite",
    "dev:all": "concurrently -n api,telemetry,web -c green,magenta,cyan \"npm:api\" \"npm:telemetry\" \"npm:dev\"",
    "build": "vite build",
    "test:e2e": "node scripts/e2e-browser.mjs",
    "test:voice-proxy": "node --env-file-if-exists=server/.env scripts/test-voice-proxy.mjs",
    "preview": "vite preview",
    "softdocs": "node scripts/build-soft-copyright-pdfs.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "GPL-2.0-only",
  "description": "",
  "dependencies": {
    "cesium": "^1.137.0",
    "echarts": "^6.0.0",
    "gsap": "^3.14.2",
    "jose": "^6.2.12",
    "lil-gui": "^0.21.0",
    "mqtt": "^5.14.1",
    "pg": "^8.23.1",
    "three": "^0.182.0",
    "vue": "^3.5.28",
    "vue-router": "^4.6.4",
    "ws": "^8.19.0"
  },
  "devDependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@vitejs/plugin-vue": "^6.0.4",
    "concurrently": "^9.2.0",
    "dompurify": "^3.3.2",
    "jsdom": "^28.1.0",
    "marked": "^17.0.4",
    "mermaid": "^11.13.0",
    "pdf-lib": "^1.17.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-cesium": "^1.2.23"
  }
}
